# Company brain (private instance — client names, identity, connections)
# NEVER commit this directory. It contains all company-specific data.
# Leading slash anchors to repo root — does NOT match templates/company/.
/company/
# ...and as a bare entry, because worktree-init creates `company` as a
# SYMLINK to the main checkout, and `company/` only matches a directory.
# Without this the link shows up untracked in every worktree and could be
# committed, publishing the private path layout.
company

# External reference repos (cloned separately, not part of the brain repo)
*-ref/

# IDE transient files
ide/

# Daily worker outputs and operator-specific configs (per-machine, regenerated)
config/social-video-digest.json
state/
digests/

# Datadog Port 1 trace storage — machine-local, gitignored by design
# (decision §9 Q3 of feature-datadog-port.md). Documented in docs/trace-storage.md.
traces/

# Cache and backups
cache/
backups/
image-cache/

# Lock files
*.lock

# Neural activity log (append-only, local)
neural_activity.json
neural_activity.jsonl

# Settings (local per machine)
settings.json

# Plugin state
plugins/

# Subagent task transcripts (background-task outputs may contain client tokens)
tasks/

# Last-cleanup timestamp (local marker, no value in public history)
.last-cleanup

# Claude Code CLI update-check result (auto-regenerated per `claude` invocation)
.last-update-result.json

# Per-machine working notes (daily trending digests, repo-deep-learn clones + reports).
# Reports live here as evidence of analysis; never auto-staged by ai-push (knowledge/
# not in BRAIN_PATHS allowlist). Keeping the dir itself out of git status reduces noise.
knowledge/

# Session-extracted draft skills — produced by /learn (session-learn-extractor).
# MUST stay local until the operator manually promotes a draft via
#   mv skills/learned/<slug> skills/<slug>
# Drafts are unreviewed scaffolds; pushing them would pollute the public connectome
# with provisional content. This rule is the canonical companion of skills/learned/
# (see skills/session-learn-extractor/SKILL.md).
skills/learned/

# Nested project memories (per-arm .claude/ dirs)
.claude/

# Sensitive local-machine files (never commit)
.credentials.json
history.jsonl
mcp-needs-auth-cache.json
projects/
session-env/
sessions/
shell-snapshots/
downloads/
telemetry/

# Session/debug data (may contain client PII)
debug/
file-history/
todos/

# Per-machine settings (no secrets but machine-specific)
settings.local.json

# Auto-generated — regenerated by ai-push, not source of truth
neural_map.json
stats-cache.json
connectome.html
# `lib/` was intended for Python venv-style local libs; rooted to repo root
# so it doesn't accidentally swallow legitimate `scripts/lib/` source code
# (the hook_flags.py drop, caught 2026-05-28).
/lib/

# ── SECURITY: Binary & personal file blanket blocks ──────────────
# The brain must ONLY contain text-based skills, agents, and config.
# No binaries, no personal documents, no media, no secrets.

# Documents (personal/client data risk)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
*.odt
*.ods
*.odp
*.csv
*.rtf

# Images (never belong in brain root — use external URLs)
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.bmp
/*.svg
/*.webp
/*.ico
/*.tiff
/*.heic
# Allow skill marketplace icons (small, part of skill metadata)
!skills/*/assets/*.png
!skills/*/assets/*.svg

# Personal assets (signatures, photos, IDs)
assets/signature/

# Archives
*.zip
*.tar
*.gz
*.bz2
*.7z
*.rar

# Secrets & certificates
*.key
*.pem
*.crt
*.p12
*.pfx
*.keystore
*.jks
*.env
*.env.*
.env
.env.*
.dev.vars

# Audio/video (never belong in brain)
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.mkv
*.flac
*.ogg

# Compiled / binary
*.exe
*.dll
*.so
*.dylib
*.o
*.pyc
*.class
*.wasm

# Database dumps
*.sql
*.dump
*.bak

# OS junk
.DS_Store
Thumbs.db
desktop.ini
paste-cache/

# Port 4 Watchdog suppression + dedup state — machine-local
watchdog/

# Port 3 SLOs state — machine-local
slos/
slos.yaml
slos.json
SLO_REPORT.md

# Port 6 incidents — private operational data, machine-local
incidents/

# ── SDD artifacts NEVER at brain root ────────────────────────────
# feature.md and plan.md belong in the ARM that owns the feature, or in
# company/ (gitignored). At the brain root they leak internal roadmap,
# inspiration sources, and strategic plans into the public repo even when
# they contain zero client identifiers (check-generic.py won't catch them).
# Root-anchored so docs/specs-archive/ and templates/ are still allowed.
/feature.md
/feature-*.md
/plan.md
/plan-*.md
/spec.md
/spec-*.md

# FinOps — per-operator private config (cost caps + vendor analytics dumps).
# Encodes per-client pricing decisions and may include client identifiers; must
# NEVER enter the public brain repo. The brain code reads these at runtime
# (budget-check.py, anthropic-analytics-pull.py); operator drops them in by
# hand on each laptop.
/budgets.yaml
/budgets.json
/analytics/

# Runtime operational state — never commit
/daemon.log
/daemon.status.json
/daemon/
/jobs/
/gh-pr-status-cache.json
/settings.json.bak.*

# Daily GH-trending digest outputs are transient data; HISTORY.md is the kept ledger
knowledge/github-trending/20*.md
knowledge/github-trending/20*.json

# Lineage graph — per-turn ledger + unlit-neuron candidates are local scratch.
# A grep fallback can capture an arm path, so these never leave the machine until
# an arm-token redactor exists. The canonical graph (connectome/lineage.yaml) IS tracked.
/.cache/graph-ledger/
/connectome/lineage.unverified.yaml

# GitHub wiki mirror checkout used by scripts/publish-wiki.py (disposable clone)
/.cache/octorato-wiki/

# 4D session-dimension registry + merge approvals (per-machine runtime state)
connectome/sessions.json
connectome/merge-approvals.json

# Per-session upload scratch dirs (session-id named, runtime state)
uploads/

# Estado de ejecucion de los hooks (ledgers, avisos). Trae JIDs de chats de
# cliente: nunca debe salir al repo publico.
.cache/

# Bases del fixture del selftest: se generan en cada corrida con instantes
# relativos, para que el gate no pueda aprobar con una ventana invertida.
registry/fixtures/**/home/.wa-fixture/*.db

# Wrapper del native host de Chrome: lo genera Claude Code con la ruta absoluta
# de ESTA maquina y la version del binario clavada. Estado local, no framework.
/chrome/

# Runtime state written by the harness on THIS machine: the daemon auth
# cooldown stamp, its status file, and the local remote-control settings.
# Same class as /chrome/ above, local state and not framework.
/daemon-auth-cooldown
/daemon-auth-status.json
/remote-settings.json
