# Company brain (private instance — client names, identity, connections)
# NEVER commit this directory. It contains all company-specific data.
# Leading slash anchors to repo root — does NOT match templates/company/.
/company/

# External reference repos (cloned separately, not part of the brain repo)
*-ref/

# IDE transient files
ide/

# Daily worker outputs and operator-specific configs (per-machine, regenerated)
config/social-video-digest.json
state/
digests/

# Cache and backups
cache/
backups/
image-cache/

# Lock files
*.lock

# Neural activity log (append-only, local)
neural_activity.json
neural_activity.jsonl

# Settings (local per machine)
settings.json

# Plugin state
plugins/

# Subagent task transcripts (background-task outputs may contain client tokens)
tasks/

# Last-cleanup timestamp (local marker, no value in public history)
.last-cleanup

# Nested project memories (per-arm .claude/ dirs)
.claude/

# Sensitive local-machine files (never commit)
.credentials.json
history.jsonl
mcp-needs-auth-cache.json
projects/
session-env/
sessions/
shell-snapshots/
downloads/
telemetry/

# Session/debug data (may contain client PII)
debug/
file-history/
todos/

# Per-machine settings (no secrets but machine-specific)
settings.local.json

# Auto-generated — regenerated by ai-push, not source of truth
neural_map.json
stats-cache.json
connectome.html
lib/

# ── SECURITY: Binary & personal file blanket blocks ──────────────
# The brain must ONLY contain text-based skills, agents, and config.
# No binaries, no personal documents, no media, no secrets.

# Documents (personal/client data risk)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
*.odt
*.ods
*.odp
*.csv
*.rtf

# Images (never belong in brain root — use external URLs)
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.bmp
/*.svg
/*.webp
/*.ico
/*.tiff
/*.heic
# Allow skill marketplace icons (small, part of skill metadata)
!skills/*/assets/*.png
!skills/*/assets/*.svg

# Personal assets (signatures, photos, IDs)
assets/signature/

# Archives
*.zip
*.tar
*.gz
*.bz2
*.7z
*.rar

# Secrets & certificates
*.key
*.pem
*.crt
*.p12
*.pfx
*.keystore
*.jks
*.env
*.env.*
.env
.env.*
.dev.vars

# Audio/video (never belong in brain)
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.mkv
*.flac
*.ogg

# Compiled / binary
*.exe
*.dll
*.so
*.dylib
*.o
*.pyc
*.class
*.wasm

# Database dumps
*.sql
*.dump
*.bak

# OS junk
.DS_Store
Thumbs.db
desktop.ini
paste-cache/
