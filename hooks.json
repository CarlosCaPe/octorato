{
  "$schema": "Shared hooks distributed via ai-push/ai-pull. Merged into each machine's settings.json by scripts/merge-hooks.py. Edit hooks HERE (tracked) — never only in settings.json (gitignored, per-machine), or other machines won't get them.",
  "PostToolUse": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "Skill"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "Agent"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase execute",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase diligent",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/canon-heal-hook.py",
          "statusMessage": "♥ healing canon to unison...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/impact-radius-hook.py",
          "statusMessage": "♥ scanning impact radius...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/cadence-lint.py --hook",
          "statusMessage": "✍ cadence lint (anti AI-tells)...",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "Write|Edit"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/client-doc-lint-hook.py",
          "statusMessage": "✍ client-doc-lint (entregable cliente)...",
          "timeout": 20,
          "type": "command"
        }
      ],
      "matcher": "Bash"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/d__posttool__delegation-ledger.py",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "*"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/r__posttool__receipt-seek.py",
          "statusMessage": "🧾 receipt: seek recorded",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "mcp__whatsapp__list_messages|mcp__whatsapp__get_message_context|mcp__gmail__search_emails|mcp__gmail__read_email|mcp__claude_ai_Gmail__search_threads|mcp__claude_ai_Gmail__get_thread|mcp__claude_ai_Gmail__get_message|Bash"
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/budget-check.py --json",
          "statusMessage": "♦ FinOps: budget cap check (fail-open)...",
          "timeout": 10,
          "type": "command"
        }
      ],
      "matcher": "Agent"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase gate",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/delegate-gate.py",
          "statusMessage": "♦ delegate reflex (connect, don't SELF)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/dimension-awareness-hook.py",
          "statusMessage": "♦ 4D: checking parallel dimensions...",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "Write|Edit"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/g__pretool-bash__git-discipline.py",
          "statusMessage": "♦ git discipline (no _old/_backup names)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/r__pretool-write__base-freshness.py",
          "type": "command"
        }
      ],
      "matcher": "Write|Edit|NotebookEdit|MultiEdit"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/qa-merge-gate.py",
          "statusMessage": "♦ QA gate (fail-closed on merge)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/grafo-gate.py",
          "statusMessage": "♦ ¿y el grafo? (seek > scan)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/delegate-gate.py",
          "statusMessage": "♦ delegate reflex (connect, don't SELF)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/dimension-awareness-hook.py",
          "statusMessage": "♦ 4D: checking parallel dimensions...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/secrets-grep-guard.py",
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__pretool-bash__git-discipline.py",
          "statusMessage": "♦ git discipline (no --force to main)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/config-ship-verify.py",
          "type": "command"
        }
      ],
      "matcher": "Bash"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/g__pretool-mcp__chat-context.py",
          "statusMessage": "♦ chat-context: tail del hilo antes de enviar (block-once)...",
          "timeout": 10,
          "type": "command"
        }
      ],
      "matcher": "mcp__whatsapp__send_message"
    },
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/g__pretool-mcp__outward-send.py",
          "statusMessage": "🧾 outward-send gate (receipts before the send)...",
          "timeout": 10,
          "type": "command"
        }
      ],
      "matcher": "mcp__gmail__send_email|mcp__claude_ai_Gmail__send_message|mcp__claude_ai_Gmail__reply|mcp__claude_ai_Gmail__forward|mcp__whatsapp__send_message|mcp__whatsapp__send_file|mcp__whatsapp__send_audio_message|Bash"
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/merge-hooks.py",
          "statusMessage": "♦ reconciling settings.json from hooks.json (drift self-heal)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/session-isolation-hook.py",
          "statusMessage": "♦ 4D: dimension isolation (auto-fork)...",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/cadence-stop-hook.py",
          "statusMessage": "✍ cadence check on the reply...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__draft-promise.py",
          "statusMessage": "✍ draft-promise check (no future-tense in drafts)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__unsourced-attribute.py",
          "statusMessage": "🏷 atributo-sin-fuente (adjetivo que la contraparte no dijo)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__unsourced-absence.py",
          "statusMessage": "🔎 ausencia-sin-busqueda (no reconozco / sin origen, sin seek)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__paste-ready-raw.py",
          "statusMessage": "📋 paste-ready check (raw message, block last)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__defer-today.py",
          "statusMessage": "⏳ hoy-no-mañana (no aplazar trabajo propio)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/source-attribution-check.py",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase disclose",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/no-pause-suggestion.py",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/grafo-ledger-check.py",
          "statusMessage": "♦ checking graph ledger...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/claim-verify-stop.py",
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__delegation-audit.py",
          "statusMessage": "♦ delegation audit (bulk fetch → cheap tier)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/d__stop__wa-guardia.py",
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/g__stop__goal-anchor.py",
          "type": "command"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/grafo-turn-reset.py",
          "statusMessage": "♦ resetting turn ledger...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/connectome-heartbeat.py",
          "statusMessage": "♥ Circulating the connectome...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/arm-recall-hook.py",
          "statusMessage": "♦ arm recall (knowledge.json + memoria)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/brain-memory-recall.py",
          "statusMessage": "🧠 brain memory recall (life-memories)...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/inbox-sweep-reflex.py",
          "statusMessage": "✉ inbox sweep reflex...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/eye-check.py",
          "statusMessage": "Checking if octopus needs eyes...",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase describe",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/trace-hook.py --phase delegate",
          "timeout": 5,
          "type": "command"
        },
        {
          "command": "python3 ~/.claude/scripts/4d-reminder.py",
          "statusMessage": "Injecting 4D reasoning...",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "command": "python3 ~/.claude/scripts/r__subagent-stop__qa-receipt.py",
          "statusMessage": "🧾 receipt: QA verdict recorded",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "*"
    }
  ]
}
