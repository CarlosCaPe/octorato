#!/usr/bin/env bash
# pre-push — second enforcement layer for the "Brain Stays Generic" rule.
#
# Runs on EVERY `git push` against this repo (including direct `git push`,
# not just the `ai-push` workflow). Replaces the blunt DO-NOT-PUSH-FROM-*
# remote-URL guardrail with content-aware path + secret scanning.
#
# Bypass (intentional override):    git push --no-verify
# Configure paths/patterns:         .githooks/push-policy.txt
# Operator-private identifiers:     company/brain-blocklist.txt (gitignored)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$REPO_ROOT" ] && { echo "pre-push: not in a git repo" >&2; exit 0; }

POLICY="$REPO_ROOT/.githooks/push-policy.txt"

# The blocklist is gitignored, so it exists ONLY in the main checkout: a git
# worktree gets tracked files and nothing else. Resolving it from $REPO_ROOT
# meant every push from a worktree ran with an EMPTY blocklist and silently
# allowed what it exists to stop. That is not hypothetical: a client's company
# name reached a public branch that way, from a worktree the session-isolation
# hook had created automatically. --git-common-dir points at the main .git even
# from a linked worktree, so its parent is where the private data lives.
MAIN_ROOT="$(dirname "$(git rev-parse --git-common-dir 2>/dev/null)")"
BLOCKLIST="$REPO_ROOT/company/brain-blocklist.txt"
if [ ! -f "$BLOCKLIST" ] && [ -f "$MAIN_ROOT/company/brain-blocklist.txt" ]; then
  BLOCKLIST="$MAIN_ROOT/company/brain-blocklist.txt"
fi
ZERO="0000000000000000000000000000000000000000"

# ── Load policy ────────────────────────────────────────────────────────────

DENY_PATHS=()
DENY_CONTENT=()
section=""
if [ -f "$POLICY" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
      "[paths]")    section="paths"; continue ;;
      "[content]")  section="content"; continue ;;
    esac
    case "$section" in
      paths)   DENY_PATHS+=("$line") ;;
      content) DENY_CONTENT+=("$line") ;;
    esac
  done < "$POLICY"
fi

# Layer the private blocklist on top (case-insensitive whole-word matching)
# This mirrors `scripts/check-generic.py` semantics but runs at push time too.
BLOCKLIST_TOKENS=()
if [ -f "$BLOCKLIST" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    BLOCKLIST_TOKENS+=("$line")
  done < "$BLOCKLIST"
fi

BLOCKLIST_RE=""
if [ ${#BLOCKLIST_TOKENS[@]} -eq 0 ]; then
  # A guard that disables itself when its data is missing, silently, is how the
  # leak got out. The universal policy still runs; say out loud that the private
  # layer is not. Never fatal: an outside contributor legitimately has no
  # blocklist, and the repo must stay pushable for them.
  echo "pre-push: NOTE — company/brain-blocklist.txt not found; the private" >&2
  echo "  client-name layer is NOT active for this push (universal policy still runs)." >&2
fi
if [ ${#BLOCKLIST_TOKENS[@]} -gt 0 ]; then
  # join tokens with | for a single alternation; escape regex metachars
  for t in "${BLOCKLIST_TOKENS[@]}"; do
    esc=$(printf '%s' "$t" | sed 's/[][\\.*^$(){}?+|/]/\\&/g')
    [ -z "$BLOCKLIST_RE" ] && BLOCKLIST_RE="$esc" || BLOCKLIST_RE="$BLOCKLIST_RE|$esc"
  done
fi

# ── Helpers ────────────────────────────────────────────────────────────────

FAIL=0
declare -a REASONS

block() { REASONS+=("$1"); FAIL=1; }

scan_paths() {
  local files="$1"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    for pat in "${DENY_PATHS[@]}"; do
      if printf '%s' "$f" | grep -Eq -- "$pat"; then
        block "path '$f' matches denied pattern /$pat/"
      fi
    done
  done <<EOF
$files
EOF
}

scan_added_content() {
  local added="$1"
  for pat in "${DENY_CONTENT[@]}"; do
    if printf '%s' "$added" | grep -Eq -- "$pat"; then
      local sample
      sample=$(printf '%s' "$added" | grep -E -- "$pat" | head -2 | sed 's/^/      /')
      block "added line matches denied pattern /$pat/:
$sample"
    fi
  done
  if [ -n "$BLOCKLIST_RE" ]; then
    if printf '%s' "$added" | grep -Eiq -- "\b($BLOCKLIST_RE)\b"; then
      local sample
      sample=$(printf '%s' "$added" | grep -Ei -- "\b($BLOCKLIST_RE)\b" | head -2 | sed 's/^/      /')
      block "added line matches company blocklist (company/brain-blocklist.txt):
$sample"
    fi
  fi
}

scan_messages() {
  local msgs="$1"
  for pat in "${DENY_CONTENT[@]}"; do
    if printf '%s' "$msgs" | grep -Eq -- "$pat"; then
      block "commit message matches denied pattern /$pat/"
    fi
  done
  if [ -n "$BLOCKLIST_RE" ]; then
    if printf '%s' "$msgs" | grep -Eiq -- "\b($BLOCKLIST_RE)\b"; then
      block "commit message matches company blocklist"
    fi
  fi
}

# ── Iterate refs being pushed ──────────────────────────────────────────────

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # ref deletion, nothing to scan

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch — find commits unique to this push (not in any other remote ref)
    commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)
  else
    commits=$(git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true)
  fi
  [ -z "$commits" ] && continue

  files=$(printf '%s\n' "$commits" | xargs -I{} git diff-tree --no-commit-id --name-only -r {} 2>/dev/null | sort -u | grep -v '^$' || true)
  if [ -n "$files" ]; then
    scan_paths "$files"
  fi

  # Added lines only (^+ but not ^+++ which is a diff header)
  added=$(printf '%s\n' "$commits" | xargs -I{} git show --no-color --format= {} 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  if [ -n "$added" ]; then
    scan_added_content "$added"
  fi

  msgs=$(printf '%s\n' "$commits" | xargs -I{} git log --format='%B%n---%n' -1 {} 2>/dev/null || true)
  if [ -n "$msgs" ]; then
    scan_messages "$msgs"
  fi
done

# ── Verdict ────────────────────────────────────────────────────────────────

if [ "$FAIL" -ne 0 ]; then
  {
    echo ""
    echo "✗ pre-push: REFUSED by .githooks/push-policy.txt"
    echo ""
    for r in "${REASONS[@]}"; do
      echo "  • $r"
    done
    echo ""
    echo "Options:"
    echo "  • Remove the offending file or rewrite the offending content"
    echo "  • Edit .githooks/push-policy.txt if the rule is too broad"
    echo "  • Bypass once (only if intentional): git push --no-verify"
  } >&2
  exit 1
fi

# Detect a working Python interpreter. On Windows, plain `python3` often resolves
# to the Microsoft Store stub which exits non-zero on every invocation ("Python
# was not found; run without arguments to install..."), so naive `python3 foo.py`
# fails before the real check runs and the operator sees a misleading error.
# Prefer python3; fall back to python; require the candidate to actually execute
# a trivial Python statement before accepting it (filters out the MS Store stub).
PYTHON=""
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
    PYTHON="$cand"
    break
  fi
done

# Lineage graph integrity (fail-closed): a rotted surface/derivation index makes
# every `SEEK-COMPLETE` a lie. Block the push until the graph is sound. The gate's
# own inputs are fail-closed too: a missing doctor or graph must block, never
# silently skip — a constitutional gate must never vanish silently.
if [ ! -f "$REPO_ROOT/scripts/lineage-doctor.py" ] || [ ! -f "$REPO_ROOT/connectome/lineage.yaml" ]; then
  {
    echo ""
    echo "✗ pre-push: lineage gate inputs MISSING (scripts/lineage-doctor.py or connectome/lineage.yaml)."
    echo "  The graph-integrity gate cannot be skipped silently. Restore the files and re-push."
  } >&2
  exit 1
fi
if [ -z "$PYTHON" ]; then
  {
    echo ""
    echo "✗ pre-push: no working Python found on PATH (tried python3, python)."
    echo "  Lineage soundness check requires Python. Install one and re-push."
  } >&2
  exit 1
fi
if ! "$PYTHON" "$REPO_ROOT/scripts/lineage-doctor.py" --quiet >/dev/null 2>&1; then
  {
    echo ""
    echo "✗ pre-push: lineage graph is UNSOUND (dangling edge or cycle)."
    "$PYTHON" "$REPO_ROOT/scripts/lineage-doctor.py" 2>&1 | sed 's/^/  /'
    echo ""
    echo "  Fix connectome/lineage.yaml so the seek can be trusted, then re-push."
  } >&2
  exit 1
fi

# OCTORATO-WIRE-GATE — RULE #1 (Wired or Corrupt). docs/architecture/wired-or-corrupt.md
# brain_doctor --registry asserts every registry rule is wired (script on disk + in
# hooks.json + anchor live). A registry that references a phantom script, fails its
# schema, or points at a dead anchor = CORRUPT brain. Block the push. Coverage WARN
# (prose not yet wired) never blocks; only CORRUPT (a FAIL) does. This stanza + the
# doctor's D0 sentinel grep are the self-wired fixed point of Rule #1.
if [ ! -f "$REPO_ROOT/scripts/brain_doctor.py" ] || [ ! -f "$REPO_ROOT/registry/rules.yaml" ]; then
  {
    echo ""
    echo "✗ pre-push: RULE #1 gate inputs MISSING (scripts/brain_doctor.py or registry/rules.yaml)."
    echo "  The constitutional gate cannot be skipped silently. Restore the files and re-push."
  } >&2
  exit 1
fi
if [ -z "$PYTHON" ]; then
  {
    echo ""
    echo "✗ pre-push: no working Python found; RULE #1 registry gate requires Python."
  } >&2
  exit 1
fi
if ! "$PYTHON" "$REPO_ROOT/scripts/brain_doctor.py" --registry >/dev/null 2>&1; then
  {
    echo ""
    echo "✗ pre-push: brain is CORRUPT — a registry rule is not wired (RULE #1)."
    "$PYTHON" "$REPO_ROOT/scripts/brain_doctor.py" --registry 2>&1 | sed 's/^/  /'
    echo ""
    echo "  Fix registry/rules.yaml so every rule's mechanism is live, then re-push."
  } >&2
  exit 1
fi
# v7: prove the gates on the exact tree being pushed and write the gate receipt
# (~/.claude/.cache/receipts/global.jsonl). Without it the outward-send gate
# refuses every send at this HEAD until a doctor runs; with it, a push and a
# receipt are the same event. A dead gate (selftest FAIL) blocks the push: RULE #1.
if ! "$PYTHON" "$REPO_ROOT/scripts/brain_doctor.py" --gate-receipt >/dev/null 2>&1; then
  {
    echo ""
    echo "✗ pre-push: a fail-closed gate does not pass its own selftest (dead gate)."
    "$PYTHON" "$REPO_ROOT/scripts/brain_doctor.py" --gate-receipt 2>&1 | sed 's/^/  /'
  } >&2
  exit 1
fi

# OCTORATO-MANIFEST-GATE: RULE #1 extended from rules to capabilities (v5.0).
# capability_manifest.py --check asserts docs/CAPABILITIES.md reflects the live
# capability set (skills/agents/scripts/rules/hooks). A skill/agent/script/rule
# added without regenerating the manifest means the offering silently drifts, the
# exact regression-by-replacement v5.0 exists to stop. ai-push regenerates the
# manifest before staging, so this never fires on the canonical path; it catches a
# direct `git push` with a stale manifest. Determinism verified before flipping to
# fail-closed: byte-identical output, no env-specifics, gitignored cruft excluded.
if [ ! -f "$REPO_ROOT/scripts/capability_manifest.py" ]; then
  {
    echo ""
    echo "✗ pre-push: scripts/capability_manifest.py MISSING — the manifest gate cannot be skipped silently."
  } >&2
  exit 1
fi
if [ -z "$PYTHON" ]; then
  {
    echo ""
    echo "✗ pre-push: no working Python found; the capability-manifest gate requires Python."
  } >&2
  exit 1
fi
if ! "$PYTHON" "$REPO_ROOT/scripts/capability_manifest.py" --check >/dev/null 2>&1; then
  {
    echo ""
    echo "✗ pre-push: docs/CAPABILITIES.md is STALE (a capability changed without regen)."
    echo "  Run: python3 scripts/capability_manifest.py  then commit it, and re-push."
  } >&2
  exit 1
fi

exit 0
