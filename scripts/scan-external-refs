#!/usr/bin/env bash
# scan-external-refs — Scan reference repos for new skills, agents, and patterns
#
# Scans all *-ref directories under ~/.claude/ for skill and agent definitions,
# compares against the brain's current inventory, and reports new/updated items.
#
# Usage:
#   scan-external-refs              # Scan all reference repos
#   scan-external-refs claude-mem   # Scan specific ref repo
#   scan-external-refs --diff       # Show detailed diffs for changed items

set -euo pipefail

CLAUDE_DIR="$HOME/.claude"
SKILLS_DIR="$CLAUDE_DIR/skills"
AGENTS_DIR="$CLAUDE_DIR/agents"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }
header(){ echo -e "${BOLD}${CYAN}$1${NC}"; }

SHOW_DIFF=false
TARGET_REF=""

for arg in "$@"; do
    case "$arg" in
        --diff) SHOW_DIFF=true ;;
        *) TARGET_REF="$arg" ;;
    esac
done

# Collect brain inventory
declare -A BRAIN_SKILLS
for skill_dir in "$SKILLS_DIR"/*/; do
    skill_name=$(basename "$skill_dir")
    BRAIN_SKILLS["$skill_name"]=1
done

declare -A BRAIN_AGENTS
while IFS= read -r agent_file; do
    agent_name=$(basename "$agent_file" .md)
    BRAIN_AGENTS["$agent_name"]=1
done < <(find "$AGENTS_DIR" -name "*.md" -not -name "REGISTRY.md" -not -name "README.md" 2>/dev/null)

total_new_skills=0
total_new_agents=0
total_new_patterns=0

# Scan each reference repo
for ref_dir in "$CLAUDE_DIR"/*-ref/; do
    [[ -d "$ref_dir" ]] || continue
    ref_name=$(basename "$ref_dir")

    # Filter if specific ref requested
    if [[ -n "$TARGET_REF" && "$ref_name" != "${TARGET_REF}-ref" && "$ref_name" != "$TARGET_REF" ]]; then
        continue
    fi

    header "=== $ref_name ==="

    # Get last update info
    if [[ -d "$ref_dir/.git" ]]; then
        last_commit=$(cd "$ref_dir" && git log -1 --format="%h %s (%cr)" 2>/dev/null || echo "unknown")
        echo "  Last commit: $last_commit"
    fi

    # Reset per-ref dedup
    unset SEEN_SKILLS 2>/dev/null || true

    # --- Scan for skills ---
    new_skills=0
    skill_dirs=()
    declare -A SEEN_SKILLS  # dedup across skill locations within same ref

    # Common skill locations in external repos
    for skill_path in \
        "$ref_dir/plugin/skills" \
        "$ref_dir/.claude/skills" \
        "$ref_dir/skills" \
        "$ref_dir/openclaw/skills"; do

        [[ -d "$skill_path" ]] || continue

        for skill_dir in "$skill_path"/*/; do
            [[ -d "$skill_dir" ]] || continue
            skill_name=$(basename "$skill_dir")

            # Skip if already seen in another location within this ref
            [[ -n "${SEEN_SKILLS[$skill_name]:-}" ]] && continue
            SEEN_SKILLS["$skill_name"]=1

            # Check if we already have this skill
            if [[ -z "${BRAIN_SKILLS[$skill_name]:-}" ]]; then
                # Extract description from SKILL.md or first .md file
                desc=""
                for md in "$skill_dir"SKILL.md "$skill_dir"*.md; do
                    if [[ -f "$md" ]]; then
                        desc=$(grep -m1 "^description:" "$md" 2>/dev/null | sed 's/^description:\s*//' || \
                               head -5 "$md" | grep -v "^---" | grep -v "^#" | head -1)
                        break
                    fi
                done
                echo -e "  ${GREEN}NEW SKILL${NC}: $skill_name"
                [[ -n "$desc" ]] && echo "    $desc"
                new_skills=$((new_skills + 1))
                skill_dirs+=("$skill_dir")
            fi
        done
    done

    # --- Scan for agents ---
    new_agents=0
    for agent_path in \
        "$ref_dir/agents" \
        "$ref_dir/.claude/agents" \
        "$ref_dir/.agent"; do

        [[ -d "$agent_path" ]] || continue

        while IFS= read -r agent_file; do
            agent_name=$(basename "$agent_file" .md)
            [[ "$agent_name" == "REGISTRY" || "$agent_name" == "README" ]] && continue

            if [[ -z "${BRAIN_AGENTS[$agent_name]:-}" ]]; then
                desc=$(head -3 "$agent_file" | grep -v "^#" | head -1)
                echo -e "  ${GREEN}NEW AGENT${NC}: $agent_name"
                [[ -n "$desc" ]] && echo "    $desc"
                new_agents=$((new_agents + 1))
            fi
        done < <(find "$agent_path" -name "*.md" -not -name "REGISTRY.md" -not -name "README.md" 2>/dev/null)
    done

    # --- Scan for interesting patterns (hooks, plugins, configs) ---
    new_patterns=0
    patterns=()

    # Hook scripts (claude-mem specific)
    if [[ -d "$ref_dir/src/hooks" ]]; then
        hook_count=$(find "$ref_dir/src/hooks" -name "*.ts" 2>/dev/null | wc -l)
        if [[ $hook_count -gt 0 ]]; then
            echo -e "  ${CYAN}PATTERN${NC}: $hook_count lifecycle hooks (src/hooks/)"
            new_patterns=$((new_patterns + 1))
        fi
    fi

    # MCP server configurations
    if [[ -f "$ref_dir/.mcp.json" ]]; then
        echo -e "  ${CYAN}PATTERN${NC}: MCP server config (.mcp.json)"
        new_patterns=$((new_patterns + 1))
    fi

    # Plugin manifests
    if [[ -f "$ref_dir/plugin/plugin.json" || -f "$ref_dir/.claude-plugin/plugin.json" ]]; then
        echo -e "  ${CYAN}PATTERN${NC}: Claude Code plugin manifest"
        new_patterns=$((new_patterns + 1))
    fi

    # Summary for this ref
    echo ""
    echo "  Summary: $new_skills new skills, $new_agents new agents, $new_patterns patterns"
    echo ""

    total_new_skills=$((total_new_skills + new_skills))
    total_new_agents=$((total_new_agents + new_agents))
    total_new_patterns=$((total_new_patterns + new_patterns))
done

# --- Grand summary ---
echo ""
header "=== SCAN SUMMARY ==="
echo "  New skills found:   $total_new_skills"
echo "  New agents found:   $total_new_agents"
echo "  Patterns found:     $total_new_patterns"

if [[ $total_new_skills -gt 0 || $total_new_agents -gt 0 ]]; then
    echo ""
    warn "  To adopt a skill:  cp -r ~/.claude/<ref>/plugin/skills/<name> ~/.claude/skills/<name>"
    warn "  To adopt an agent: cp ~/.claude/<ref>/agents/<name>.md ~/.claude/agents/<division>/<name>.md"
    warn "  Then run:          ai-push \"adopted <name> from <ref>\""
fi
