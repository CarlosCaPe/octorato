{
  "arms_paths": {
    "open": "arms/open",
    "closed": "arms/closed"
  },
  "files": {
    "arms/open/arm.json": {
      "kind": "arm",
      "name": "open",
      "version": "1.0.0",
      "license": "proprietary",
      "telemetry": {
        "export": "allow"
      }
    },
    "arms/closed/arm.json": {
      "kind": "arm",
      "name": "closed",
      "version": "1.0.0",
      "license": "proprietary",
      "telemetry": {
        "export": "deny"
      }
    }
  },
  "dirs": [
    "arms/open/src",
    "arms/closed/src",
    "elsewhere"
  ],
  "project_dir": "{{SANDBOX}}/arms/closed",
  "payload": {
    "session_id": "sess-guard",
    "hook_event_name": "Stop",
    "cwd": "{{SANDBOX}}/arms/open/src"
  },
  "_comment": "cwd in the allow arm, CLAUDE_PROJECT_DIR in the deny arm.",
  "_setup": {
    "expect_reason": "different arms"
  }
}
