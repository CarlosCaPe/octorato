{
  "_comment": "An unregistered arm.json with no telemetry field inside an allow arm: absent means deny.",
  "_setup": {
    "expect_reason": "Export_Policy of the arm.json at"
  },
  "arms_paths": {
    "open": "arms/open"
  },
  "files": {
    "arms/open/arm.json": {
      "kind": "arm",
      "name": "open",
      "telemetry": {
        "export": "allow"
      }
    },
    "arms/open/sub/arm.json": {
      "kind": "arm",
      "name": "sub"
    }
  },
  "payload": {
    "session_id": "sess-guard",
    "hook_event_name": "Stop",
    "cwd": "{{SANDBOX}}/arms/open/sub"
  }
}
