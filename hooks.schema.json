{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Octorato hooks.json — tracked source of truth for Claude Code hooks",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "patternProperties": {
    "^(UserPromptSubmit|PreToolUse|PostToolUse|Stop|SubagentStop|Notification|PreCompact|SessionStart)$": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matcher": { "type": "string" },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "type": { "const": "command" },
                "command": { "type": "string", "minLength": 1 },
                "timeout": { "type": "integer", "minimum": 1, "maximum": 60 },
                "statusMessage": { "type": "string" }
              },
              "required": ["type", "command"],
              "additionalProperties": false
            }
          }
        },
        "required": ["hooks"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
